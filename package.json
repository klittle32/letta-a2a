{
  "name": "letta-a2a-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "release:bundle": "node scripts/release/check-bundle.mjs",
    "release:packed": "node scripts/release/packed-consumer.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "integration": "node scripts/integration-a2a.mjs",
    "smoke": "node scripts/smoke-a2a.mjs",
    "test": "bun test",
    "test:python": "(cd services/reference-agent && uv run pytest) && (cd services/google-adk-agent && uv run pytest)",
    "test:example-12": "node scripts/integration-example-12.mjs",
    "test:example-12:live": "node scripts/live-example-12.mjs",
    "test:protocol": "node scripts/integration-a2a.mjs --protocol-only",
    "test:integration": "node scripts/integration-a2a.mjs",
    "test:compose": "OPENAI_API_KEY=sk-compose-validation docker compose config --quiet"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@letta-ai/letta-agent-sdk": "0.8.3",
    "express": "5.1.0",
    "jose": "6.2.9",
    "letta-a2a-bridge": "file:packages/letta-a2a-bridge",
    "letta-a2a-client": "file:packages/letta-a2a-client",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
