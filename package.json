{
  "name": "letta-a2a-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "integration": "node scripts/integration-a2a.mjs",
    "smoke": "node scripts/smoke-a2a.mjs",
    "test": "bun test",
    "test:python": "(cd services/reference-agent && uv run pytest) && (cd services/google-adk-agent && uv run pytest)",
    "test:example-12": "node scripts/integration-example-12.mjs",
    "test:example-13": "A2ACLI_REAL_BINARY_TEST=1 bun test tests/a2acli-source-contract.test.ts && node scripts/integration-example-13.mjs",
    "test:example-13:live": "node scripts/live-example-13.mjs",
    "test:example-12:live": "node scripts/live-example-12.mjs",
    "test:protocol": "node scripts/integration-a2a.mjs --protocol-only",
    "test:integration": "node scripts/integration-a2a.mjs",
    "test:compose": "OPENAI_API_KEY=sk-compose-validation docker compose config --quiet"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@letta-ai/letta-code": "0.30.25",
    "express": "5.1.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
