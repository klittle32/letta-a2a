{
  "name": "letta-a2a-client",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Governed A2A 1.0 client library with optional Letta Agent SDK and Letta Code adapters",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klittle32/letta-a2a.git",
    "directory": "packages/letta-a2a-client"
  },
  "bugs": "https://github.com/klittle32/letta-a2a/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./agent-sdk": {
      "types": "./dist/lib/agent-sdk.d.ts",
      "import": "./dist/lib/agent-sdk.js"
    }
  },
  "keywords": [
    "letta-package",
    "letta-mod",
    "a2a"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "MOD.md",
    "dist",
    "src"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "dist/a2a-client.mjs"
    ],
    "capabilities": [
      "tools"
    ]
  },
  "scripts": {
    "prepublishOnly": "node -e \"throw new Error('Publication requires separate approval; see docs/RELEASING.md')\"",
    "build": "tsc -p tsconfig.build.json && bun build mods/a2a-client.ts --target=node --format=esm --outfile=dist/a2a-client.mjs",
    "test": "bun test",
    "check": "tsc --noEmit && bun run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0"
  },
  "devDependencies": {
    "@letta-ai/letta-agent-sdk": "0.8.3",
    "@types/bun": "1.3.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "@letta-ai/letta-agent-sdk": "0.8.3"
  },
  "peerDependenciesMeta": {
    "@letta-ai/letta-agent-sdk": {
      "optional": true
    }
  },
  "trustedDependencies": [
    "@letta-ai/letta-code"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
