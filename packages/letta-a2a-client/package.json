{
  "name": "letta-a2a-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "letta-package",
    "letta-mod",
    "a2a"
  ],
  "files": [
    "README.md",
    "MOD.md",
    "dist",
    "src"
  ],
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "dist/a2a-client.mjs"
    ],
    "capabilities": [
      "tools"
    ]
  },
  "scripts": {
    "build": "bun build mods/a2a-client.ts --target=node --format=esm --outfile=dist/a2a-client.mjs",
    "test": "bun test",
    "check": "tsc --noEmit && bun run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
