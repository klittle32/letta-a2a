{
  "name": "letta-a2a-bridge",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "A2A 1.0 bridge for Letta agents with explicit execution ownership and local durable recovery",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klittle32/letta-a2a.git",
    "directory": "packages/letta-a2a-bridge"
  },
  "bugs": "https://github.com/klittle32/letta-a2a/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "node -e \"throw new Error('Publication requires separate approval; see docs/RELEASING.md')\"",
    "build": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@types/express": "5.0.3",
    "@letta-ai/letta-agent-sdk": "0.8.3",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "trustedDependencies": [
    "@letta-ai/letta-code"
  ]
}
