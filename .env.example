# Required. Used only by the two isolated local Letta runtimes.
OPENAI_API_KEY=

# Use any model handle available through the configured OpenAI provider.
LETTA_TEST_MODEL=openai/gpt-4.1-nano

# Lab-only credentials. Do not reuse production credentials here.
LETTA_APP_SERVER_TOKEN=a2a-lab-app-server-token
OAUTH_CLIENT_ID=operator-client
OAUTH_CLIENT_SECRET=operator-client-secret
OAUTH_BRIDGE_CLIENT_ID=bridge-client
OAUTH_BRIDGE_CLIENT_SECRET=bridge-client-secret
OAUTH_REFERENCE_CLIENT_ID=reference-agent-client
OAUTH_REFERENCE_CLIENT_SECRET=reference-agent-client-secret
OAUTH_OBSERVER_CLIENT_ID=observer-client
OAUTH_OBSERVER_CLIENT_SECRET=observer-client-secret
OAUTH_DENIED_CLIENT_ID=denied-invoker-client
OAUTH_DENIED_CLIENT_SECRET=denied-invoker-client-secret
PUSH_CALLBACK_TOKEN=a2a-lab-callback-secret
PUSH_OBSERVER_TOKEN=a2a-lab-observer-secret

A2A_GATEWAY_PORT=4000
A2A_GATEWAY_UI_PORT=4090
OAUTH_PORT=9001
PUSH_RECEIVER_PORT=8100
OAUTH_TOKEN_TTL_SECONDS=60
TURN_TIMEOUT_MS=120000
MAX_A2A_HOPS=1
